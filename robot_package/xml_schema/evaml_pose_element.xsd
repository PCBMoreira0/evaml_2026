		<!-- Including the EVAML basic type definitions -->
    <xs:include schemaLocation="./evaml_basic_types.xsd"></xs:include>

    <!-- EVAML motion command definition ** -->
	<xs:element name="pose">
		<xs:complexType>
			<xs:attribute name="commMode" type="xs:string" fixed="MQTT_PUB"/>
			<xs:attribute name="pubTopic" type="xs:string" fixed="pose"/> <!-- Here it should be more topics. It needs to be solved... May be in the robot module... -->
			<xs:attribute name="id" type="idType"/>
			<xs:attribute name="type" type="poseListType" use="required"/>
		</xs:complexType>
	</xs:element>

	<!-- Motion type definition -->
	<xs:simpleType name="poseListType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="NEUTRAL"/>
			<xs:enumeration value="LEFT_FOOT1"/>
			<xs:enumeration value="LEFT_FOOT2"/>
			<xs:enumeration value="RIGHT_FOOT1"/>
			<xs:enumeration value="RIGHT_FOOT2"/>
			<xs:enumeration value="SAD_FOOT_SLOW"/>
			<xs:enumeration value="SAD_FOOT_FAST"/>
			<xs:enumeration value="TIPTOE_FOOT"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
