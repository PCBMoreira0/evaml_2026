		<!-- Including the EVAML basic type definitions -->
    <xs:include schemaLocation="./evaml_basic_types.xsd"></xs:include>

    <!-- EVAML motion command definition ** -->
	<xs:element name="motion">
		<xs:complexType>
			<xs:attribute name="commMode" type="xs:string" fixed="MQTT_PUB"/>
			<xs:attribute name="pubTopic" type="xs:string" fixed="move"/> <!-- Here it should be more topics. It needs to be solved... May be in the robot module... -->
			<xs:attribute name="id" type="idType"/>
			<xs:attribute name="type" type="motionListType" use="required"/>
		</xs:complexType>
	</xs:element>

	<!-- Motion type definition -->
	<xs:simpleType name="motionListType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="FORWARD"/>
			<xs:enumeration value="FORWARD2"/>
			<xs:enumeration value="BACKWARD"/>
			<xs:enumeration value="BACKWARD2"/>
			<xs:enumeration value="LEFT"/>
			<xs:enumeration value="LEFT_MOON"/>
			<xs:enumeration value="RIGHT"/>
			<xs:enumeration value="RIGHT_MOON"/>
			<xs:enumeration value="MOONWALK"/>
			<xs:enumeration value="MOONWALK2"/>
			<xs:enumeration value="DANCE1"/>
			<xs:enumeration value="DANCE1_2"/>
			<xs:enumeration value="DANCE2"/>
			<xs:enumeration value="DANCE2_2"/>
			<xs:enumeration value="STOMPING_FOOT_R"/>
			<xs:enumeration value="STOMPING_FOOT_L"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
