	<!-- Including the EVAML basic type definitions -->
    <xs:include schemaLocation="./evaml_basic_types.xsd"></xs:include>
	
    <!-- ** EVAML mqtt command definition ** -->
	<xs:element name="perception">
		<xs:complexType>
			<xs:attribute name="commMode" type="xs:string" fixed="MQTT_PUB"/>
			<xs:attribute name="pubTopic" type="xs:string" fixed="PERCEPTION"/>
			<xs:attribute name="action" type="actionListType" use="required"/>
			<xs:attribute name="sources" type="xs:string" />
			<xs:attribute name="id" type="idType"/>
			<!-- <xs:attribute name="topic" type="xs:string" use="required"/> -->
		</xs:complexType>
	</xs:element>

	<!-- Motion type definition -->
	<xs:simpleType name="actionListType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="START"/>
			<xs:enumeration value="END"/>
		</xs:restriction>
	</xs:simpleType>

</xs:schema>
