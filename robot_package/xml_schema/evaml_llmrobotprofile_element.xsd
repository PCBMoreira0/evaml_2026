	<!-- Including the EVAML basic type definitions -->
    <xs:include schemaLocation="./evaml_basic_types.xsd"></xs:include>

    <!-- EVAML  command definition ** -->
	<xs:simpleType name="zeroToOneDecimal">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="0.0"/>
			<xs:maxInclusive value="1.0"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="llmRobotProfile">
		<xs:complexType mixed="true">
			<xs:attribute name="commMode" type="xs:string" fixed="NULL"/>
			<xs:attribute name="temperature" type="zeroToOneDecimal" use="optional"/>
			<xs:attribute name="numPredict" type="xs:positiveInteger" use="optional"/>
		</xs:complexType>
	</xs:element>
</xs:schema>
