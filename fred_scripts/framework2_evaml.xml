<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="teste" xsi:noNamespaceSchemaLocation="../robot_package/xml_schema/evaml_schema.xsd">
  <settings>
    <voice type="en_US-bryce-medium" commMode="NULL" />
    <lightEffects mode="ON" commMode="NULL" />
    <audioEffects mode="ON" commMode="NULL" vol="100%" />
    <robotAffectiveProfile profile="OPTIMISTIC" commMode="MQTT_PUB" pubTopic="ROBOT_AFFECTIVE_PROFILE" empathy="0.5" decay="0.5" decayDelay="2.0" baseMood="0.0, 0.0, 0.0" />
  </settings>
  <script>
    <light id="BEGIN" state="ON" commMode="MQTT_PUB" pubTopic="LIGHT" ipAdress="192.168.99.11" ipPort="55443" color="WHITE" />
    <wait duration="1" commMode="NULL" />
    <talk id="ROBOT_TALK" commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Hello, how are you?</talk>
    <useMacro macro="START" commMode="NULL" />
    <goto target="POINT1" commMode="NULL" />
    <listen commMode="MQTT_PUB_SUB" pubTopic="LISTEN" subTopic="LISTEN_RESPONSE" language="pt-BR" />
    <llm commMode="NULL">$</llm>
    <goto target="BEGIN" commMode="NULL" />
  </script>
  <macros commMode="NULL">
    <macro id="START" commMode="NULL">
      <led animation="GREEN" commMode="MQTT_PUB" pubTopic="leds" />
      <light id="POINT1" state="ON" commMode="MQTT_PUB" pubTopic="LIGHT" ipAdress="192.168.99.11" ipPort="55443" color="WHITE" />
    </macro>
    <macro id="MACRO1" commMode="NULL">
      <debug operation="PAUSE" commMode="NULL" />
    </macro>
    <macro id="MACRO2" commMode="NULL">
      <random min="1" max="2" commMode="NULL" />
    </macro>
  <macro id="MACRO3" commMode="NULL">
    <random min="1" max="2" commMode="NULL" />
  </macro>
<macro id="MACRO4" commMode="NULL">
  <random min="1" max="2" commMode="NULL" />
</macro>

<macro id="MACRO5" commMode="NULL">
  <random min="1" max="2" commMode="NULL" />
</macro>
</macros>
</evaml>