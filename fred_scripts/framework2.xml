<?xml version="1.0" encoding="UTF-8"?>
<evaml
  name="teste"
  xsi:noNamespaceSchemaLocation="../robot_package/xml_schema/evaml_schema.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <settings>
    <voice type="en_US-bryce-medium" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
    <robotAffectiveProfile profile="OPTIMISTIC" />
  </settings>
  <script>
    <light id="BEGIN" state="ON" />
    <wait duration="1" />
    <talk id="ROBOT_TALK">Hello, how are you?</talk>
    <useMacro macro="START" />
    <goto target="POINT1" />
    <listen />
    <llm>$</llm>
    <goto target="BEGIN" />
  </script>
  <macros>
    <macro id="START">
      <led animation="GREEN" />
      <light id="POINT1" state="ON" />
    </macro>
    <macro id="MACRO1">
      <debug operation="PAUSE" />
    </macro>
    <macro id="MACRO2">
      <random min="1" max="2" />
    </macro>
  <macro id="MACRO3">
    <random min="1" max="2" />
  </macro>
<macro id="MACRO4">
  <random min="1" max="2" />
</macro>

<macro id="MACRO5">
  <random min="1" max="2" />
</macro>
</macros>
</evaml>