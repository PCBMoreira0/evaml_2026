<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="teste" xsi:noNamespaceSchemaLocation="../robot_package/xml_schema/evaml_schema.xsd">
  <settings>
    <voice type="pt-BR_IsabelaV3Voice" commMode="NULL" />
    <lightEffects mode="ON" commMode="NULL" />
    <audioEffects mode="ON" commMode="NULL" vol="100%" />
  </settings>
  <script>
    <light state="ON" color="GREEN" commMode="MQTT_PUB" pubTopic="LIGHT" ipAdress="192.168.99.11" ipPort="55443" />
    <evaEmotion emotion="PLEASED" commMode="MQTT_PUB" pubTopic="expression" />
    <led animation="GREEN" commMode="MQTT_PUB" pubTopic="leds" />
    <evaEmotion emotion="SPEECH_ON_2" commMode="MQTT_PUB" pubTopic="expression" />
    <talk voiceType="en-US_AllisonV3Voice" commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Hello, how are you?</talk>
    <talk voiceType="pt-BR_IsabelaV3Voice" commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Gerando uma voz no IBM</talk>
    <evaEmotion emotion="SPEECH_OFF_2" commMode="MQTT_PUB" pubTopic="expression" />
    <audio source="efx-blin" block="TRUE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <evaEmotion emotion="NEUTRAL" commMode="MQTT_PUB" pubTopic="expression" />
    <light state="OFF" commMode="MQTT_PUB" pubTopic="LIGHT" ipAdress="192.168.99.11" ipPort="55443" color="WHITE" />
    <led animation="BLACK" commMode="MQTT_PUB" pubTopic="leds" />
  </script>
</evaml>