@startuml
title Multimodal Affective Interaction Flow

autonumber

actor User

participant SENSEI
participant STT
participant FER
participant TER
participant PULSE
participant ROSE
participant AEB
participant Robot

== Perception Window Configuration ==

SENSEI -> PULSE: perception(start,\nexpectedSources = [FER, TER])
activate PULSE
PULSE -> PULSE: Create perception window\nRegister expected sources
deactivate PULSE

par Activate FER
    SENSEI -> FER: perception(start)
    activate FER
    FER -> FER: Start facial data collection
else Activate TER
    SENSEI -> TER: perception(start)
    activate TER
    TER -> TER: Initialize perception context
end

== User Response Acquisition ==

SENSEI -> User: Ask interaction question
SENSEI -> STT: listen()
activate STT

User -> STT: Spoken response
STT -> STT: Detect end of speech\nand transcribe audio
STT --> SENSEI: Transcribed text
deactivate STT

SENSEI -> TER: analyzeText(text)
TER -> TER: Infer categorical\nemotion probabilities

== Perception Window Closure ==

SENSEI -> PULSE: perception(end)
activate PULSE
PULSE -> PULSE: Mark perception window\nas closed
deactivate PULSE

par Close FER processing
    SENSEI -> FER: perception(end)
    FER -> FER: Stop frame collection
    FER -> FER: Aggregate frame-level\nemotion probabilities
    FER -> PULSE: CAT result\nsource = FER
    deactivate FER
else Close TER processing
    SENSEI -> TER: perception(end)
    TER -> PULSE: CAT result\nsource = TER
    deactivate TER
end

== Multimodal Fusion ==

activate PULSE
PULSE -> PULSE: Verify expected sources
PULSE -> PULSE: Estimate confidence\nusing normalized entropy
PULSE -> PULSE: Fuse FER and TER\nprobability distributions
PULSE -> PULSE: Convert fused CAT\ndistribution to user VAD
PULSE -> ROSE: User VAD + confidence
deactivate PULSE

== Robot Affective State Modeling ==

activate ROSE
ROSE -> ROSE: Update robot affective state\nusing empathy factor,\naffective decay, and base mood
ROSE -> AEB: Robot VAD
deactivate ROSE

== Behavior Generation ==

activate AEB
AEB -> AEB: Transform robot VAD into\ngeneric multimodal\nbehavior parameters
AEB --> SENSEI: Behavior vector
deactivate AEB

== Behavior Execution ==

activate SENSEI
SENSEI -> SENSEI: Map generic parameters to\nrobot-specific commands
SENSEI -> Robot: Execute behavior
activate Robot

Robot -> Robot: Facial expression
Robot -> Robot: Body/head movement
Robot -> Robot: Speech/prosody
Robot -> Robot: Light effects

Robot --> SENSEI: Behavior completed
deactivate Robot
deactivate SENSEI

legend bottom
  CAT = categorical emotion probability distribution
  VAD = valence, arousal, and dominance
  FER = facial expression recognition
  TER = text emotion recognition
  STT = speech-to-text
endlegend

@enduml