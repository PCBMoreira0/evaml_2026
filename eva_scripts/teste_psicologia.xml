<macro id="pergunta1">
<led animation="HAPPY"/>
<log name="logterapia">Como você se sente quando ganha um presente?</log>
<talk>Como você se sente quando ganha um presente?</talk>
<talk>Feliz, Triste ou com Raiva?</talk>
<qrRead var="resposta1"/>
<switch var="resposta1">
<case op="exact" value="feliz">
<log name="logterapia">#resposta1</log>
<log name="logterapia">#acerto</log>
<log name="logterapia">§</log>
<counter var="pontuacao" op="+" value="1" />
<evaEmotion emotion="HAPPY" />
<led animation="HAPPY" />
<motion head="YES"/>
<talk>Muito bem!/Resposta correta!/Acertou!</talk>
<evaEmotion emotion="NEUTRAL" />
</case>
<default>
<log name="logterapia">#resposta1</log>
<log name="logterapia">#erro</log>
<log name="logterapia">§</log>
<evaEmotion emotion="SAD" />
<led animation="ANGRY" />
<motion head="NO"/>
<talk>Acho que essa não é a resposta mais correta. Vamos escolher outra resposta</talk>
<evaEmotion emotion="NEUTRAL" />
<useMacro macro="pergunta1" />
</default>
</switch>
</macro>

