      <led animation="HAPPY" />
      <switch var="pergunta5">
      <case op="eq" value="5">
      <useMacro macro="pergunta5" />
      <counter var="pergunta5" op="=" value="0" />
      
      </case>
      <case op="eq" value="0">
      <led animation="SAD" />
      <goto target="volta" />
      
      </case>
      
      </switch>
      
      </case>

