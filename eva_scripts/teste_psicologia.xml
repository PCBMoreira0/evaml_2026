    <counter var="pergunta1" op="=" value="1" />
    <counter var="pergunta2" op="=" value="2" />
    <counter var="pergunta3" op="=" value="3" />
    <counter var="pergunta4" op="=" value="4" />
    <counter var="pergunta5" op="=" value="5" />
    <counter var="pergunta6" op="=" value="6" />
    <counter var="pergunta7" op="=" value="7" />
    <counter var="pergunta8" op="=" value="8" />
    <counter var="pergunta9" op="=" value="9" />
    <counter var="pergunta10" op="=" value="10" />
    <counter var="pergunta11" op="=" value="11" />
    <counter var="pergunta12" op="=" value="12" />
    <counter var="pergunta13" op="=" value="13" />
    <counter var="pergunta14" op="=" value="14" />
