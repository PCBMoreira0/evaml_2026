        <case op="eq" value="4">
        <useMacro macro="pergunta4" />
        <counter var="pergunta4" op="=" value="0" />
        
        </case>
        <case op="eq" value="0">
        <led animation="SAD" />
        <goto target="volta" />
        
        </case>
        
        </switch>
      
      </case>

