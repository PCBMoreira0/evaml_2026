          <case op="eq" value="2">
            <useMacro macro="pergunta2" />
            <counter var="pergunta2" op="=" value="0" />
          </case>
          <case op="eq" value="0">
          <led animation="SAD" />
          <goto target="volta" />
          </case>
        </switch>
      </case>
      <case op="eq" value="3">
      <led animation="HAPPY" />
        <switch var="pergunta3">
            <case op="eq" value="3">
                <useMacro macro="pergunta3" />
                <counter var="pergunta3" op="=" value="0" />
            </case>
            <case op="eq" value="0">
            <led animation="SAD" />
            <goto target="volta" />
            
            </case>
