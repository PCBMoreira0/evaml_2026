<?xml version="1.0" encoding="UTF-8"?>
<evaml
  name="teste"
  xsi:noNamespaceSchemaLocation="../robot_package/xml_schema/evaml_schema.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <settings>
    <voice type="en-US_EmmaExpressive" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    <loop times="4">
      <talk>qual o seu nome?</talk>
      <log name="lognome">qual o seu nome?</log>
      <listen var="nome"/>
      <log name="lognome">#nome</log>
      <switch var="nome">
        <case op="exact" value="maria">
          <log name="lognome">acerto</log>
          <log name="lognome">§</log>
        </case>
        <default>
          <log name="lognome">erro</log>
          <log name="lognome">§</log>
        </default>
      </switch>
      <talk>olá #nome</talk>
      <log name="lognome">~</log>

    </loop>
  </script>
</evaml>