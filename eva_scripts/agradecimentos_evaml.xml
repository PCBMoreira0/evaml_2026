<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="agradecimentos" xsi:noNamespaceSchemaLocation="../robot_package/xml_schema/evaml_schema.xsd">
  <settings>
    <voice type="pt_BR-faber-medium" commMode="NULL" />
    <lightEffects mode="ON" commMode="NULL" />
    <audioEffects mode="ON" commMode="NULL" vol="100%" />
  </settings>
  <script>
    <light state="ON" color="BLUE" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <motion head="CENTER" rightArm="POSITION 0" leftArm="POSITION 3" commMode="MQTT_PUB" pubTopic="MOTION" />
    <evaEmotion emotion="NEUTRAL" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <audio source="efx-blin2" block="TRUE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Sejam bem vindos!</talk>
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Eu sou o robô social Eva</talk>
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Sou um robô destinado a aplicações em saúde e educação</talk>
    <motion rightArm="POSITION 3" leftArm="POSITION 0" commMode="MQTT_PUB" pubTopic="MOTION" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Gostaria de agradecer aos responsáveis por permitirem que essas meninas super poderosas participassem do meu teste</talk>
    <light state="ON" color="GREEN" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <evaEmotion emotion="HAPPY" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <motion head="UP" commMode="MQTT_PUB" pubTopic="MOTION" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Muito obrigado a todos!</talk>
    <light state="ON" color="YELLOW" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <led animation="SURPRISE" commMode="MQTT_PUB" pubTopic="LEDS" />
    <audio source="song-aquarela" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <motion head="2NO" rightArm="SHAKE2" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="6" commMode="NULL" />
    <motion head="2NO" commMode="MQTT_PUB" pubTopic="MOTION" />
    <motion rightArm="SHAKE2" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="7" commMode="NULL" />
    <motion leftArm="POSITION 0" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="2" commMode="NULL" />
    <led animation="STOP" commMode="MQTT_PUB" pubTopic="LEDS" />
    <evaEmotion emotion="NEUTRAL" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <motion head="CENTER" rightArm="POSITION 0" commMode="MQTT_PUB" pubTopic="MOTION" />
  </script>
</evaml>