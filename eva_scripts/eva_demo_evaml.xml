<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="eva_demo" xsi:noNamespaceSchemaLocation="../robot_package/xml_schema/evaml_schema.xsd">
  <settings>
    <voice type="en-US_AllisonExpressive" commMode="NULL" />
    <lightEffects mode="ON" commMode="NULL" />
    <audioEffects mode="ON" commMode="NULL" vol="100%" />
  </settings>
  <script>
    
    <light state="OFF" commMode="MQTT_PUB" pubTopic="LIGHT" color="WHITE" />
    <evaEmotion emotion="NEUTRAL" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <led animation="STOP" commMode="MQTT_PUB" pubTopic="LEDS" />
    <motion head="CENTER" rightArm="POSITION 0" leftArm="POSITION 0" commMode="MQTT_PUB" pubTopic="MOTION" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Hi, every body!</talk>
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">My name is Eva.</talk>
    <audio source="efx-blin2" block="TRUE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I am a social robot.</talk>
    <wait duration="2" commMode="NULL" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I can be used in healthcare and educational applications</talk>
    <audio source="efx-blin2" block="TRUE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Now, I will initiate a test of all my capabilities</talk>


    
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I will start testing the smart bulb</talk>
    <audio source="efx-display" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <light state="ON" color="WHITE" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <wait duration="1" commMode="NULL" />
    <audio source="efx-display" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <light state="ON" color="BLUE" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <wait duration="1" commMode="NULL" />
    <audio source="efx-display" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <light state="ON" color="GREEN" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <wait duration="1" commMode="NULL" />
    <audio source="efx-display" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <light state="ON" color="RED" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <wait duration="1" commMode="NULL" />
    <audio source="efx-display" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <light state="ON" color="YELLOW" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <wait duration="1" commMode="NULL" />


    
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I can express emotions using my gaze and I will test it now</talk>
    <audio source="efx-blin2" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <evaEmotion emotion="HAPPY" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <wait duration="2" commMode="NULL" />
    <audio source="efx-blin2" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <evaEmotion emotion="SAD" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <wait duration="2" commMode="NULL" />
    <audio source="efx-blin2" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <evaEmotion emotion="ANGRY" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <wait duration="2" commMode="NULL" />
    <audio source="efx-blin2" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <evaEmotion emotion="FEAR" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <wait duration="2" commMode="NULL" />
    <audio source="efx-blin2" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <evaEmotion emotion="SURPRISE" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <wait duration="2" commMode="NULL" />
    <audio source="efx-blin2" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <evaEmotion emotion="DISGUST" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <wait duration="2" commMode="NULL" />
    <audio source="efx-blin2" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <evaEmotion emotion="INLOVE" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <wait duration="2" commMode="NULL" />

    
    
    <evaEmotion emotion="NEUTRAL" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Now, I will run some animations using the leds on my chest</talk>
    <audio source="efx-robot" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <light state="ON" color="GREEN" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <led animation="HAPPY" commMode="MQTT_PUB" pubTopic="LEDS" />
    <wait duration="5" commMode="NULL" />
    <audio source="efx-robot" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <light state="ON" color="RED" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <led animation="ANGRY" commMode="MQTT_PUB" pubTopic="LEDS" />
    <wait duration="5" commMode="NULL" />
    <audio source="efx-robot" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <light state="ON" color="YELLOW" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <led animation="SURPRISE" commMode="MQTT_PUB" pubTopic="LEDS" />
    <wait duration="5" commMode="NULL" />
    <audio source="efx-robot" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <light state="ON" color="WHITE" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <led animation="RAINBOW" commMode="MQTT_PUB" pubTopic="LEDS" />
    <wait duration="5" commMode="NULL" />

    
    <led animation="STOP" commMode="MQTT_PUB" pubTopic="LEDS" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I have non verbal capabilities so I can move my head</talk>
    <wait duration="1" commMode="NULL" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I can move up</talk>
    <audio source="efx-robot-head" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <motion type="2UP" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="2" commMode="NULL" />
    <motion type="CENTER" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="2" commMode="NULL" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I can move down</talk>
    <audio source="efx-robot-head" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <motion type="2DOWN" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="2" commMode="NULL" />
    <motion type="CENTER" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="2" commMode="NULL" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I can say no</talk>
    <light state="ON" color="RED" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <led animation="ANGRY" commMode="MQTT_PUB" pubTopic="LEDS" />
    <evaEmotion emotion="ANGRY" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <motion head="DOWN" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="1" commMode="NULL" />
    <motion type="NO" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="4" commMode="NULL" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">and I can say yes</talk>
    <led animation="HAPPY" commMode="MQTT_PUB" pubTopic="LEDS" />
    <light state="ON" color="GREEN" commMode="MQTT_PUB" pubTopic="LIGHT" />
    <evaEmotion emotion="HAPPY" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <motion type="2YES" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="4" commMode="NULL" />
    <evaEmotion emotion="NEUTRAL" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <motion head="CENTER" commMode="MQTT_PUB" pubTopic="MOTION" />
    <light state="ON" color="WHITE" commMode="MQTT_PUB" pubTopic="LIGHT" />
    
    
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I can move my right arm</talk>
    <audio source="efx-robot-arm" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <motion rightArm="POSITION 3" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="2" commMode="NULL" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I can move my left arm</talk>
    <audio source="efx-robot-arm" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <motion leftArm="POSITION 2" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="2" commMode="NULL" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">and I can shake my arms</talk>
    <audio source="song-samba-loop" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <motion leftArm="SHAKE2" rightArm="SHAKE2" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="6" commMode="NULL" />
    <motion rightArm="POSITION 0" leftArm="POSITION 0" commMode="MQTT_PUB" pubTopic="MOTION" />

    
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I can also play sounds</talk>
    <audio source="efx-blin" block="TRUE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">I can play some good music too</talk>
    <audio source="song-rude-magic" block="FALSE" commMode="MQTT_PUB_SUB" pubTopic="AUDIO" subTopic="AUDIO_RESPONSE" />
    <led animation="SURPRISE" commMode="MQTT_PUB" pubTopic="LEDS" />
    <motion head="RIGHT_UP2" rightArm="POSITION 3" leftArm="POSITION 0" commMode="MQTT_PUB" pubTopic="MOTION" />
    <evaEmotion emotion="HAPPY" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
    <wait duration="7" commMode="NULL" />
    <motion head="LEFT_UP2" rightArm="POSITION 0" leftArm="POSITION 3" commMode="MQTT_PUB" pubTopic="MOTION" />
    <wait duration="7" commMode="NULL" />
    <motion head="CENTER" rightArm="POSITION 0" leftArm="POSITION 0" commMode="MQTT_PUB" pubTopic="MOTION" />

    
    <led animation="STOP" commMode="MQTT_PUB" pubTopic="LEDS" />
    <motion head="CENTER" commMode="MQTT_PUB" pubTopic="MOTION" />
    
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">That is all folks</talk>
    <wait duration="1" commMode="NULL" />
    <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="TALK_RESPONSE">Good bye!</talk>
    <light state="OFF" commMode="MQTT_PUB" pubTopic="LIGHT" color="WHITE" />
  </script>
</evaml>