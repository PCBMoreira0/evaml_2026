    <counter var="pergunta13" op="=" value="13" commMode="NULL" />
    <counter var="pergunta14" op="=" value="14" commMode="NULL" />
    <counter var="pergunta15" op="=" value="15" commMode="NULL" />
    <counter var="pergunta16" op="=" value="16" commMode="NULL" />
