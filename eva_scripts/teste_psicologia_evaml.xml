  <macros commMode="NULL">
    <macro id="pergunta1" commMode="NULL">
      <log name="logterapia" commMode="MQTT_PUB" pubTopic="LOG">Como você se sente quando ganha um presente?</log>
      <led animation="HAPPY" id="novamente" commMode="MQTT_PUB" pubTopic="LEDS" />
      <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="state"> Como você se sente quando ganha um presente? </talk>
      <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="state">Feliz, Triste ou com Raiva?</talk>
      <qrRead var="resposta1" commMode="MQTT_PUB_SUB" pubTopic="QRREAD" subTopic="QRREAD_RESPONSE" />
      <switch var="resposta1" commMode="NULL">
        <case op="exact" value="feliz" commMode="NULL">
          <log name="logterapia" commMode="MQTT_PUB" pubTopic="LOG">#resposta1</log>
          <log name="logterapia" commMode="MQTT_PUB" pubTopic="LOG">#acerto</log>
          <led animation="HAPPY" commMode="MQTT_PUB" pubTopic="LEDS" />
          <motion head="YES" commMode="MQTT_PUB" pubTopic="MOTION" />
          <evaEmotion emotion="HAPPY" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
          <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="state">Muito bem!/Resposta correta!/Acertou!</talk>
          <evaEmotion emotion="NEUTRAL" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
        </case>
        <default commMode="NULL">
          <log name="logterapia" commMode="MQTT_PUB" pubTopic="LOG">#resposta1</log>
          <log name="logterapia" commMode="MQTT_PUB" pubTopic="LOG">#erro</log>
          <led animation="ANGRY" commMode="MQTT_PUB" pubTopic="LEDS" />
          <motion head="NO" commMode="MQTT_PUB" pubTopic="MOTION" />
          <evaEmotion emotion="SAD" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
          <talk commMode="MQTT_PUB_SUB" pubTopic="TALK" subTopic="state">Acho que essa não é a resposta mais correta. Vamos escolher outra resposta</talk>
          <goto target="novamente" commMode="NULL" />
          <evaEmotion emotion="NEUTRAL" commMode="MQTT_PUB" pubTopic="EVAEMOTION" />
        </default>


      </switch>
      <log name="logterapia" commMode="MQTT_PUB" pubTopic="LOG">§</log>
    </macro>

